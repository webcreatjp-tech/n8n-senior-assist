      "parameters": {
        "jsCode": "// Récupère les données d'absence\nconst absence = $('Code — Vérifie absence').first().json;\n\n// Snapshots des deux caméras (peut être null si caméra hors ligne)\nconst salonBin  = $('HTTP — Photo Salon').first().binary?.photo_salon  ?? null;\nconst entreeBin = $('HTTP — Photo Entrée').first().binary?.photo_entree ?? null;\n\n// Construit le résultat avec JSON + binaires\nconst binary = {};\nif (salonBin)  binary.photo_salon  = salonBin;\nif (entreeBin) binary.photo_entree = entreeBin;\n\nconst nbPhotos = Object.keys(binary).length;\nreturn [{\n  json: { ...absence, nb_photos: nbPhotos },\n  binary\n}];"
