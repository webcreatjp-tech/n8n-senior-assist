    {
      "parameters": {
        "jsCode": "const events = $input.all().map(i => i.json);\n\n// Si au moins un événement dans les 2h → tout va bien\nif (events && events.length > 0 && events[0].id) {\n  return [];\n}\n\n// Aucune détection depuis 2h en journée → anomalie\nconst heure = new Date().toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'});\nconst heure_num = new Date().getHours();\n\n// Double vérification horaire (8h-20h)\nif (heure_num < 8 || heure_num > 20) return [];\n\nreturn [{ json: {\n  type_alerte: 'ABSENCE ANORMALE',\n  message_alerte: `Aucune présence détectée (salon ou entrée) depuis plus de 2 heures. Dernière vérification à ${heure}. Le résident n'a pas été vu depuis un moment inhabituel.`,\n  niveau_urgence: 'ATTENTION',\n  heure,\n  camera: 'toutes'\n}}];"
      },
