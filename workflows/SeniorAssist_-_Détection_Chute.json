h=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f6f6f6; border-radius:10px; border:1px solid #e8e8e8;\">\n              <tr><td style=\"padding:12px; text-align:center;\">\n                <div style=\"font-size:20px; font-weight:700; color:#444;\">{{ $json.duree }}s</div>\n                <div style=\"font-size:11px; color:#999; margin-top:4px; text-transform:uppercase; letter-spacing:0.05em;\">Durée immobile</div>\n              </td></tr>\n            </table>\n          </td>\n          <td width=\"33%\" style=\"padding:0 4px;\">\n            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f6f6f6; border-radius:10px; border:1px solid #e8e8e8;\">\n              <tr><td style=\"padding:12px; text-align:center;\">\n                <div style=\"font-size:20px; font-weight:700; color:#444;\">{{ $json.score }}%</div>\n                <div style=\"font-size:11px; color:#999; margin-top:4px; text-transform:uppercase; letter-spacing:0.05em;\">Score détection</div>\n              </td></tr>\n            </table>\n          </td>\n          <td width=\"33%\" style=\"padding-left:4px;\">\n            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f6f6f6; border-radius:10px; border:1px solid #e8e8e8;\">\n              <tr><td style=\"padding:12px; text-align:center;\">\n                <div style=\"font-size:16px; font-weight:700; color:#444;\">{{ $json.camera }}</div>\n                <div style=\"font-size:11px; color:#999; margin-top:4px; text-transform:uppercase; letter-spacing:0.05em;\">Caméra</div>\n              </td></tr>\n            </table>\n          </td>\n        </tr>\n      </table>\n    </td>\n  </tr>\n\n  <!-- ACTION -->\n  <tr>\n    <td style=\"padding:20px 32px 28px;\">\n      <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:{{ $json.niveau_urgence === 'CRITIQUE' ? '#FCEBEB' : '#FAEEDA' }}; border-radius:10px; border:1px solid {{ $json.niveau_urgence === 'CRITIQUE' ? '#F09595' : '#FAC775' }};\">\n        <tr><td style=\"padding:14px 16px;\">\n          <p style=\"font-size:13px; font-weight:700; color:{{ $json.niveau_urgence === 'CRITIQUE' ? '#A32D2D' : '#854F0B' }}; margin:0 0 4px; text-transform:uppercase; letter-spacing:0.05em;\">Action requise</p>\n          <p style=\"font-size:14px; color:#2C2C2A; margin:0; line-height:1.6;\">{{ $json.niveau_urgence === 'CRITIQUE' ? 'Intervenir immédiatement auprès du résident. Appeler les secours si nécessaire (15 / 18).' : 'Vérifier rapidement l\\'état du résident et l\\'aider à se relever si besoin.' }}</p>\n        </td></tr>\n      </table>\n    </td>\n  </tr>\n\n  <!-- PHOTO -->\n  <tr>\n    <td style=\"padding:0 32px 20px;\">\n      <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#F5F5F5; border-radius:10px; border:1px solid #E0E0E0;\">\n        <tr><td style=\"padding:14px 16px;\">\n          <p style=\"font-size:13px; font-weight:700; color:#555; margin:0 0 4px; text-transform:uppercase; letter-spacing:0.05em;\">📷 Snapshot caméra {{ $json.camera }}</p>\n          <p style=\"font-size:13px; color:#888; margin:0; line-height:1.5;\">{{ $json.has_photo ? 'Photo ci-jointe — état de la caméra au moment de la détection.' : 'Aucune photo disponible (caméra hors ligne).' }}</p>\n        </td></tr>\n      </table>\n    </td>\n  </tr>\n\n  <!-- FOOTER -->\n  <tr>\n    <td style=\"padding:16px 32px 20px; background:#fafafa; border-top:1px solid #f0f0f0; border-radius:0 0 16px 16px;\">\n      <p style=\"font-size:12px; color:#aaa; margin:0;\">Alerte générée automatiquement par SeniorAssist — Détection Chute.</p>\n      <p style=\"font-size:12px; color:#ccc; margin:6px 0 0;\">Propulsé par <span style=\"color:#1D9E75;\">WEB-CREAT</span> · Automatisation IA pour les professionnels</p>\n    </td>\n  </tr>\n\n</table>\n</td></tr>\n</table>\n</body>\n</html>",
