      "parameters": {
        "jsCode": "let payload;\ntry {\n  payload = JSON.parse($input.item.json.message);\n} catch(e) { return []; }\n\n// Uniquement les événements de type 'update' ou 'end' avec label 'person'\nconst validTypes = ['update', 'end'];\nif (!validTypes.includes(payload.type)) return [];\n\nconst after = payload.after || {};\nconst before = payload.before || {};\n\n// Filtre : label doit être 'person'\nif (after.label !== 'person') return [];\n\n// Calcul durée d'immobilité (frame_time - start_time en secondes)\nconst startTime = after.start_time || 0;\nconst frameTime = after.frame_time || after.end_time || 0;\nconst duree = frameTime - startTime;\n\n// Score de confiance\nconst score = Math.round((after.score || 0) * 100);\n\n// Seuil de détection chute : immobilité > 20s ou position basse\n// Frigate ne détecte pas directement les chutes, on utilise la durée au sol\n// et les zones comme proxy\nconst zones = after.current_zones || after.entered_zones || [];\nconst camera = after.camera || 'inconnue';\nconst heure = new Date().toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit', second:'2-digit'});\nconst heure_num = new Date().getHours();\n\n// Ignorer si durée trop courte (< 15s = simple passage)\nif (duree < 15 && payload.type !== 'end') return [];\n\n// Déterminer le niveau d'alerte\nlet type_alerte, niveau_urgence, message_alerte;\n\nif (duree >= 45 || (payload.type === 'end' && duree >= 30)) {\n  type_alerte = 'CHUTE DÉTECTÉE';\n  niveau_urgence = 'CRITIQUE';\n  message_alerte = `Personne immobile depuis ${Math.round(duree)}s sur la caméra \"${camera}\" à ${heure}${zones.length ? ' (zone: ' + zones.join(', ') + ')' : ''}. Intervention immédiate requise.`;\n} else if (duree >= 15) {\n  type_alerte = 'POSITION AU SOL';\n  niveau_urgence = 'ATTENTION';\n  message_alerte = `Personne au sol depuis ${Math.round(duree)}s détectée sur la caméra \"${camera}\" à ${heure}${zones.length ? ' (zone: ' + zones.join(', ') + ')' : ''}.`;\n} else {\n  return [];\n}\n\nreturn [{ json: {\n  type_alerte,\n  message_alerte,\n  niveau_urgence,\n  heure,\n  camera,\n  score,\n  duree: Math.round(duree),\n  zones\n}}];"
      },
