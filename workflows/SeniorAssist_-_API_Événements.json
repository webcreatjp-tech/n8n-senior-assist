      "id": "50273988-91a3-4a10-8cda-9ac1b5e72d58",
      "name": "Frigate Events",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\n// HTTP node splits JSON array → each $input item = one Frigate event\nconst query  = $('Webhook').first().json.query || {};\nconst pid    = parseInt(query.patientId) || 1;\nconst CAMERAS = { 1: [\"zosi\"], 2: [] };\nconst NAMES   = { 1: \"Madeleine Dupont\", 2: \"Robert Martin\" };\n\nconst cameras = CAMERAS[pid] || [];\nif (cameras.length === 0)\n  return [{ json: { events: [], total: 0, patient: NAMES[pid] || 'Inconnu' } }];\n\n// Each item = one event object (HTTP node auto-splits arrays)\nconst evts = $input.all().map(i => i.json);\n\nconst formatted = evts.map(e => {\n  const d = new Date(e.start_time * 1000);\n  return {\n    id: e.id,\n    time: d.getHours().toString().padStart(2,'0') + ':' + d.getMinutes().toString().padStart(2,'0'),\n    timestamp: e.start_time,\n    label: e.label,\n    score: Math.round(((e.data && e.data.top_score) || e.top_score || 0) * 100),\n    camera: e.camera,\n    hasSnapshot: !!e.has_snapshot,\n    hasClip: !!e.has_clip\n  };\n});\n\nreturn [{ json: { events: formatted, total: formatted.length, patient: NAMES[pid] || 'Inconnu' } }];\n"
      },
