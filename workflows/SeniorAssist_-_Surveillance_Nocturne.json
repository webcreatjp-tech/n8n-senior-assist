    {
      "parameters": {
        "jsCode": "const h = new Date().getHours();\n// Plage nocturne : 22h - 6h\nconst nuit = h >= 22 || h < 6;\nif (!nuit) return []; // Rien à faire le jour\nreturn [{ json: { heure: h, nuit: true } }];"
      },
      "id": "30b4c40f-9d32-45bc-910a-f4fb92ae390e",
      "name": "Code — Heure Nocturne",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        112,
        -96
      ]
    },
    {
      "parameters": {
        "url": "=http://localhost:5000/api/events",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "limit",
              "value": "20"
            },
            {
              "name": "after",
              "value": "={{ Math.floor(Date.now()/1000) - 600 }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "b79e39e9-5297-43e7-8735-f0bbef3975da",
      "name": "HTTP — Frigate Events Nuit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        -96
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const heure_num = new Date().getHours();\nconst heure_str = new Date().toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'});\nconst date_str  = new Date().toLocaleDateString('fr-FR');\n\n// Récupérer les events Frigate des 10 dernières minutes\nlet events = [];\ntry {\n  const raw = $('HTTP — Frigate Events Nuit').first().json;\n  events = Array.isArray(raw) ? raw : [];\n} catch(e) { events = []; }\n\n// Filtrer : seulement les personnes détectées (pas les faux positifs)\nconst persons = events.filter(e =>\n  e.label === 'person' &&\n  !e.false_positive &&\n  e.top_score >= 0.5\n);\n\nif (persons.length === 0) return []; // Aucune détection → pas d'alerte\n\n// Résumé par caméra\nconst par_cam = {};\nfor (const p of persons) {\n  const cam = p.camera || 'inconnue';\n  if (!par_cam[cam]) par_cam[cam] = { count: 0, max_score: 0, last_time: 0 };\n  par_cam[cam].count++;\n  par_cam[cam].max_score = Math.max(par_cam[cam].max_score, p.top_score || 0);\n  par_cam[cam].last_time = Math.max(par_cam[cam].last_time, p.start_time || 0);\n}\n\n// Construire le message d'alerte\nconst lignes = Object.entries(par_cam).map(([cam, d]) => {\n  const score = Math.round(d.max_score * 100);\n  const t = d.last_time ? new Date(d.last_time * 1000).toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'}) : heure_str;\n  return `• Caméra ${cam.toUpperCase()} : ${d.count} détection(s), confiance ${score}%, dernière à ${t}`;\n});\n\n// Niveau d'urgence selon l'heure\n// 23h-5h : CRITIQUE (heure de sommeil profond)\n// 22h-23h et 5h-6h : ATTENTION (endormissement / réveil)\nconst critique = (heure_num >= 23 || heure_num < 5);\n\nreturn [{\n  json: {\n    type_alerte: 'PRÉSENCE NOCTURNE',\n    niveau_urgence: critique ? 'CRITIQUE' : 'ATTENTION',\n    heure: heure_str,\n    date: date_str,\n    camera: Object.keys(par_cam).join(', '),\n    nb_detections: persons.length,\n    message_alerte: `⚠️ Présence détectée la nuit (${heure_str}) :\\n${lignes.join('\\n')}\\n\\nVérification recommandée.`,\n    message_court: `Présence nocturne détectée à ${heure_str} (${persons.length} detection(s))`,\n    par_camera: par_cam\n  }\n}];"
      },
