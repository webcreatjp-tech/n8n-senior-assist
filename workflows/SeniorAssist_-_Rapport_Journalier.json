    {
      "parameters": {
        "jsCode": "const events = $input.all().map(i => i.json).filter(e => e.id);\n\nif (!events || events.length === 0) {\n  return [{ json: { \n    resume: 'Aucun événement détecté dans les dernières 24h.', \n    nb_events: 0, anomalies: 0,\n    premiere_detection: '--', derniere_detection: '--',\n    duree_moyenne: '--', score_moyen: '--',\n    statut_html: '<span style=\"background:#0F6E56; color:#9FE1CB; font-size:12px; font-weight:700; padding:5px 14px; border-radius:20px;\">✓ RAS</span>'\n  }}];\n}\n\nconst nb_events = events.length;\nlet anomalies = 0;\nconst lignes = [];\nlet total_duree = 0;\nlet total_score = 0;\nlet nb_score = 0;\n\nconst timestamps = events.map(e => e.start_time).sort();\nconst premiere = new Date(timestamps[0] * 1000).toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'});\nconst derniere = new Date(timestamps[timestamps.length - 1] * 1000).toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'});\n\n// Grouper par caméra\nconst par_camera = {};\nfor (const evt of events) {\n  const cam = evt.camera || 'inconnue';\n  if (!par_camera[cam]) par_camera[cam] = 0;\n  par_camera[cam]++;\n  \n  const date = new Date(evt.start_time * 1000);\n  const heure = date.toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'});\n  const score = evt.data?.top_score ? Math.round(evt.data.top_score * 100) : null;\n  const severity = evt.data?.max_severity || 'detection';\n  if (severity === 'alert') anomalies++;\n  const duree = evt.end_time ? Math.round(evt.end_time - evt.start_time) : null;\n  if (duree) total_duree += duree;\n  if (score) { total_score += score; nb_score++; }\n  lignes.push(`- ${heure} [${cam}] : personne (score ${score || '?'}%, durée ~${duree || '?'}s, sévérité: ${severity})`);\n}\n\nconst resume_cameras = Object.entries(par_camera).map(([cam, nb]) => `${cam}: ${nb} détection(s)`).join(', ');\nconst duree_moyenne = total_duree > 0 ? Math.round(total_duree / nb_events) + 's' : '--';\nconst score_moyen = nb_score > 0 ? Math.round(total_score / nb_score) + '%' : '--';\n\nconst resume = `Résumé du ${new Date().toLocaleDateString('fr-FR')} :\\n${nb_events} détection(s) dont ${anomalies} alerte(s).\\nCaméras actives : ${resume_cameras}\\n\\nDétail :\\n${lignes.join('\\n')}`;\n\nconst statut_html = anomalies > 0\n  ? '<span style=\"background:#7B1F1F; color:#F7C1C1; font-size:12px; font-weight:700; padding:5px 14px; border-radius:20px;\">⚠ Attention</span>'\n  : '<span style=\"background:#0F6E56; color:#9FE1CB; font-size:12px; font-weight:700; padding:5px 14px; border-radius:20px;\">✓ RAS</span>';\n\n// Version courte pour Ollama (sans le détail ligne par ligne)\nconst resume_court = `Résumé du ${new Date().toLocaleDateString('fr-FR')} :\n${nb_events} détection(s) dont ${anomalies} alerte(s).\nCaméras actives : ${resume_cameras}\nPremière détection : ${premiere} — Dernière : ${derniere}\nDurée moyenne : ${duree_moyenne} — Score moyen : ${score_moyen}\n\nAlertes entrée : ${par_camera['entree'] || 0} détections dont ${\n  events.filter(e => e.camera === 'entree' && (e.data?.max_severity || '') === 'alert').length\n} alertes entre ${\n  events.filter(e => e.camera === 'entree').map(e => \n    new Date(e.start_time * 1000).toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'})\n  ).slice(-1)[0] || '--'\n} et ${premiere}.`;\n\nreturn [{ json: { \n  resume,         // version complète (pour logs/email)\n  resume_court,   // version compressée (pour Ollama)\n  nb_events, anomalies, par_camera,\n  premiere_detection: premiere, derniere_detection: derniere,\n  duree_moyenne, score_moyen, statut_html\n}}];"
      },
