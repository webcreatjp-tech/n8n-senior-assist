           </table>\n          </td>\n          <td width=\"33%\" style=\"padding:0 5px;\">\n            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:{{ $('Code — Formate résumé').item.json.anomalies > 0 ? '#FCEBEB' : '#EAF3DE' }}; border-radius:10px; border:1px solid #e8e8e8;\">\n              <tr><td style=\"padding:14px 12px; text-align:center;\">\n                <div style=\"font-size:22px; font-weight:700; color:{{ $('Code — Formate résumé').item.json.anomalies > 0 ? '#A32D2D' : '#3B6D11' }};\">{{ $('Code — Formate résumé').item.json.anomalies }}</div>\n                <div style=\"font-size:11px; color:#999; margin-top:5px; text-transform:uppercase; letter-spacing:0.05em;\">Alertes</div>\n              </td></tr>\n            </table>\n          </td>\n          <td width=\"33%\" style=\"padding-left:5px;\">\n            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f6f6f6; border-radius:10px; border:1px solid #e8e8e8;\">\n              <tr><td style=\"padding:14px 12px; text-align:center;\">\n                <div style=\"font-size:16px; font-weight:700; color:#444; padding-top:4px;\">Salon</div>\n                <div style=\"font-size:11px; color:#999; margin-top:5px; text-transform:uppercase; letter-spacing:0.05em;\">Caméra</div>\n              </td></tr>\n            </table>\n          </td>\n        </tr>\n      </table>\n    </td>\n  </tr>\n\n  <!-- STATS LIGNE 2 -->\n  <tr>\n    <td style=\"padding:10px 32px 0;\">\n      <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n        <tr>\n          <td width=\"33%\" style=\"padding-right:5px;\">\n            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#E6F1FB; border-radius:10px; border:1px solid #e8e8e8;\">\n              <tr><td style=\"padding:14px 12px; text-align:center;\">\n                <div style=\"font-size:16px; font-weight:700; color:#0C447C; padding-top:4px;\">{{ $('Code — Formate résumé'