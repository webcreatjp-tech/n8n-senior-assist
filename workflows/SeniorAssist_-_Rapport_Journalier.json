    {
      "parameters": {
        "jsCode": "const raw = $input.item.json.response || 'Erreur génération rapport.';\n\nconst bilan = raw.split(/ANOMALIES/i)[0]\n  .replace(/BILAN\\s*/i, '')\n  .trim();\n\nconst anomalies = raw.includes('ANOMALIES')\n  ? raw.split(/ANOMALIES\\s*\\n*/i)[1].split(/RECOMMANDATIONS?/i)[0].replace(/^\\s*\\n*/, '').trim()\n  : 'Aucune anomalie détectée.';\n\nconst recommandation = raw.includes('RECOMMANDATION')\n  ? raw.split(/RECOMMANDATIONS?\\s*\\n*/i)[1].trim()\n  : 'Aucune action requise.';\n\nreturn [{ json: { rapport_final: raw, bilan, anomalies, recommandation } }];"
      },
