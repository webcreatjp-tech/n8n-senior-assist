    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>SeniorAssist — Surveillance & Soins</title>\n  <style>\n    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }\n    :root {\n      --primary:      #1F4E79;\n      --primary-l:    #2E75B6;\n      --bg:           #F2F5F9;\n      --surface:      #FFFFFF;\n      --border:       #DDE3EC;\n      --text:         #1A202C;\n      --muted:        #64748B;\n      --green:        #16A34A; --green-bg: #DCFCE7;\n      --orange:       #D97706; --orange-bg:#FEF3C7;\n      --red:          #DC2626; --red-bg:   #FEE2E2;\n      --sidebar-w:    248px;\n      --r:            10px;\n      --shadow:       0 1px 4px rgba(0,0,0,.07);\n    }\n    body { font-family: -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;\n           background:var(--bg); color:var(--text); display:flex; min-height:100vh; }\n\n    /* ── Sidebar ── */\n    .sidebar { width:var(--sidebar-w); background:var(--primary); position:fixed;\n               top:0; left:0; bottom:0; display:flex; flex-direction:column; z-index:200; }\n    .brand { padding:22px 20px 18px; border-bottom:1px solid rgba(255,255,255,.1); }\n    .brand-row { display:flex; align-items:center; gap:10px; }\n    .brand-icon { width:36px; height:36px; background:rgba(255,255,255,.15); border-radius:8px;\n                  display:flex; align-items:center; justify-content:center; font-size:18px; }\n    .brand h1 { color:#fff; font-size:17px; font-weight:700; }\n    .brand p  { color:rgba(255,255,255,.5); font-size:11px; margin-top:2px; }\n    .nav-lbl { padding:14px 20px 4px; font-size:10px; font-weight:600;\n               color:rgba(255,255,255,.35); text-transform:uppercase; letter-spacing:1.2px; }\n    .nav-item { display:flex; align-items:center; gap:10px; padding:10px 20px; cursor:pointer;\n                color:rgba(255,255,255,.7); font-size:13.5px; border-left:3px solid transparent;\n                transition:all .15s; }\n    .nav-item .ico { font-size:15px; width:20px; text-align:center; flex-shrink:0; }\n    .nav-item:hover { background:rgba(255,255,255,.07); color:#fff; }\n    .nav-item.active { background:rgba(255,255,255,.11); color:#fff; border-left-color:#5BA4D4; }\n    .sidebar-footer { padding:14px 20px; border-top:1px solid rgba(255,255,255,.08);\n                      font-size:11px; color:rgba(255,255,255,.3); margin-top:auto; }\n    #sidebar-patients-nav { padding:4px 0; }\n\n    /* ── Main ── */\n    .main { margin-left:var(--sidebar-w); flex:1; padding:28px 28px 48px; min-width:0; }\n    .ph { margin-bottom:24px; }\n    .ph h2 { font-size:22px; font-weight:700; color:var(--primary); }\n    .ph p  { color:var(--muted); font-size:13px; margin-top:3px; }\n\n    /* ── Stats ── */\n    .stat-row { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:24px; }\n    .stat-card { background:var(--surface); border:1px solid var(--border); border-radius:var(--r);\n                 padding:18px 20px; box-shadow:var(--shadow); }\n    .sl { font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:.6px; color:var(--muted); }\n    .sv { font-size:30px; font-weight:700; color:var(--primary); line-height:1.2; margin:4px 0; }\n    .ss { font-size:12px; color:var(--muted); }\n\n    /* ── Alert banner ── */\n    .alert-banner { background:var(--orange-bg); border:1px solid #FCD34D; border-radius:var(--r);\n                    padding:12px 16px; display:flex; align-items:center; gap:10px;\n                    margin-bottom:22px; font-size:13px; color:#92400E; display:none; }\n\n    /* ── Card ── */\n    .card { background:var(--surface); border:1px solid var(--border);\n            border-radius:var(--r); box-shadow:var(--shadow); }\n    .cb { padding:20px; }\n    .ct { font-size:13px; font-weight:600; color:var(--primary);\n          display:flex; align-items:center; gap:8px; margin-bottom:14px; }\n    .bc { background:var(--primary); color:#fff; font-size:10px;\n          padding:1px 6px; border-radius:20px; }\n\n    /* ── Patient cards ── */\n    .pgrid { display:grid; grid-template-columns:repeat(auto-fill,minmax(330px,1fr)); gap:16px; }\n    .pc { background:var(--surface); border:1px solid var(--border); border-radius:var(--r);\n          padding:20px; cursor:pointer; transition:box-shadow .2s,border-color .2s,transform .15s;\n          box-shadow:var(--shadow); }\n    .pc:hover { border-color:var(--primary-l); box-shadow:0 4px 14px rgba(31,78,121,.12);\n                transform:translateY(-2px); }\n    .pc-top { display:flex; align-items:flex-start; gap:14px; margin-bottom:14px; }\n    .avatar { width:46px; height:46px; border-radius:10px; flex-shrink:0; display:flex;\n              align-items:center; justify-content:center; font-size:19px; font-weight:700; color:#fff; }\n    .av-blue { background:var(--primary-l); }\n    .av-teal { background:#0D9488; }\n    .av-gray { background:#64748B; }\n    .pc-info { flex:1; }\n    .pc-info h3 { font-size:15px; font-weight:600; }\n    .pc-info p  { font-size:12px; color:var(--muted); margin-top:2px; }\n\n    /* ── Status pills ── */\n    .sp { display:inline-flex; align-items:center; gap:5px; padding:3px 10px;\n          border-radius:20px; font-size:11.5px; font-weight:600; white-space:nowrap; }\n    .sp::before { content:''; width:6px; height:6px; border-radius:50%; }\n    .sp-normal   { background:var(--green-bg);  color:var(--green);  } .sp-normal::before  { background:var(--green); }\n    .sp-alert    { background:var(--orange-bg); color:var(--orange); } .sp-alert::before   { background:var(--orange); }\n    .sp-urgent   { background:var(--red-bg);    color:var(--red);    } .sp-urgent::before  { background:var(--red); }\n    .sp-inactive { background:#F1F5F9;           color:var(--muted);  } .sp-inactive::before{ background:var(--muted); }\n\n    .cam-pills { display:flex; flex-wrap:wrap; gap:6px; margin-bottom:14px; }\n    .cam-pill { background:var(--bg); border:1px solid var(--border); border-radius:20px;\n                padding:3px 9px; font-size:11px; color:var(--muted); }\n    .pc-foot { display:flex; justify-content:space-between; align-items:center;\n               padding-top:14px; border-top:1px solid var(--border); }\n    .la-lbl { font-size:11px; color:var(--muted); font-weight:600; }\n    .la-val { font-size:12px; color:var(--text); margin-top:1px; }\n\n    /* ── Buttons ── */\n    .btn { display:inline-flex; align-items:center; gap:6px; padding:8px 14px;\n           border-radius:8px; font-size:13px; font-weight:500; cursor:pointer;\n           border:none; transition:all .15s; }\n    .btn-primary { background:var(--primary); color:#fff; }\n    .btn-primary:hover { background:var(--primary-l); }\n    .btn-ghost { background:var(--bg); color:var(--primary); border:1px solid var(--border); }\n    .btn-ghost:hover { background:var(--border); }\n    .back-btn { display:flex; align-items:center; gap:6px; padding:7px 12px;\n                background:var(--surface); border:1px solid var(--border); border-radius:8px;\n                font-size:13px; color:var(--muted); cursor:pointer; flex-shrink:0; transition:all .15s; }\n    .back-btn:hover { background:var(--bg); color:var(--primary); }\n\n    /* ── Detail layout ── */\n    .dtop { display:flex; align-items:center; gap:16px; margin-bottom:24px; }\n    .dh { flex:1; }\n    .dh h2 { font-size:20px; font-weight:700; color:var(--primary); }\n    .dh p  { font-size:12.5px; color:var(--muted); margin-top:3px; }\n    .dl { display:grid; grid-template-columns:1fr 320px; gap:20px; align-items:start; }\n\n    /* ── Events ── */\n    .evlist { display:flex; flex-direction:column; gap:8px; }\n    .ev { display:flex; align-items:center; gap:12px; padding:11px 13px;\n          background:var(--bg); border-radius:8px; border:1px solid var(--border); }\n    .ev-time { font-size:13px; font-weight:700; color:var(--primary); width:46px; flex-shrink:0; }\n    .ev-thumb { width:54px; height:38px; border-radius:6px; flex-shrink:0; object-fit:cover;\n                background:linear-gradient(135deg,#CBD5E1,#94A3B8); }\n    .ev-thumb-ph { width:54px; height:38px; border-radius:6px; flex-shrink:0;\n                   background:linear-gradient(135deg,#CBD5E1,#94A3B8);\n                   display:flex; align-items:center; justify-content:center; font-size:16px; }\n    .ev-info { flex:1; }\n    .ev-lbl  { font-size:13px; font-weight:600; text-transform:capitalize; }\n    .ev-cam  { font-size:11px; color:var(--muted); margin-top:1px; }\n    .ev-score { font-size:12px; font-weight:700; padding:2px 8px; border-radius:20px;\n                background:var(--primary); color:#fff; }\n    .ev-empty { padding:24px 0; text-align:center; color:var(--muted); font-size:13px; }\n\n    /* ── Snapshot ── */\n    .snap-ph { width:100%; height:162px; border-radius:8px;\n               background:linear-gradient(135deg,#CBD5E1 0%,#94A3B8 100%);\n               display:flex; flex-direction:column; align-items:center; justify-content:center;\n               margin-bottom:10px; color:#fff; }\n    .snap-ph span { font-size:30px; }\n    .snap-ph p { font-size:11px; opacity:.8; margin-top:6px; }\n    #pt-snap-img { width:100%; border-radius:8px; margin-bottom:10px; display:none; }\n    .snap-cap { font-size:11.5px; color:var(--muted); text-align:center; }\n\n    /* ── Report ── */\n    .rpt-date { font-size:11.5px; color:var(--muted); margin-bottom:10px; }\n    .rpt-body { font-size:13.5px; line-height:1.75; color:var(--text); white-space:pre-wrap;\n                font-family:inherit; max-height:420px; overflow-y:auto; padding-right:4px; }\n\n    /* ── Reports page ── */\n    .frow { display:flex; gap:10px; flex-wrap:wrap; margin-bottom:20px; }\n    .fsel, .fdate { padding:8px 12px; border:1px solid var(--border); border-radius:8px;\n                    background:var(--surface); color:var(--text); font-size:13px; outline:none; }\n    .fsel:focus, .fdate:focus { border-color:var(--primary-l); box-shadow:0 0 0 3px rgba(46,117,182,.12); }\n    .ri { border-bottom:1px solid var(--border); cursor:pointer; transition:background .12s; }\n    .ri:last-child { border-bottom:none; }\n    .ri:hover { background:var(--bg); }\n    .ri-hd { display:flex; justify-content:space-between; align-items:flex-start;\n             padding:14px 18px; gap:12px; }\n    .ri-patient { font-size:14px; font-weight:600; color:var(--primary); }\n    .ri-preview { font-size:12.5px; color:var(--muted); margin-top:3px; }\n    .ri-date { font-size:11px; color:var(--muted); background:var(--bg);\n               border:1px solid var(--border); border-radius:5px; padding:3px 8px; white-space:nowrap; }\n    .ri-body { display:none; padding:0 18px 16px; }\n    .ri-body.open { display:block; }\n    .ri-rpt { background:var(--bg); border:1px solid var(--border); border-radius:8px;\n              padding:14px; font-size:13px; line-height:1.7; white-space:pre-wrap; font-family:inherit; }\n    .ri-chev { font-size:12px; transition:transform .2s; flex-shrink:0; margin-top:2px; }\n    .ri-chev.open { transform:rotate(180deg); }\n\n    /* ── Loading ── */\n    .loader { display:flex; flex-direction:column; align-items:center; justify-content:center;\n              padding:48px; color:var(--muted); gap:12px; }\n    .spinner { width:28px; height:28px; border:3px solid var(--border);\n               border-top-color:var(--primary); border-radius:50%; animation:spin .7s linear infinite; }\n    @keyframes spin { to { transform:rotate(360deg); } }\n    .err-msg { background:var(--red-bg); border:1px solid var(--red); border-radius:8px;\n               padding:12px 16px; font-size:13px; color:#7F1D1D; margin:8px 0; }\n\n    /* ── Pages ── */\n    .page { display:none; }\n    .page.active { display:block; }\n\n    /* ── Responsive ── */\n    @media (max-width:900px) { .dl { grid-template-columns:1fr; } .stat-row { grid-template-columns:repeat(2,1fr); } }\n    @media (max-width:640px) {\n      :root { --sidebar-w:58px; }\n      .brand h1,.brand p,.nav-item span:not(.ico),.nav-lbl,.sidebar-footer { display:none; }\n      .main { padding:16px 14px; }\n      .stat-row { grid-template-columns:1fr 1fr; }\n    }\n  </style>\n</head>\n<body>\n\n<!-- ══ SIDEBAR ══ -->\n<aside class=\"sidebar\">\n  <div class=\"brand\">\n    <div class=\"brand-row\">\n      <div class=\"brand-icon\">🏥</div>\n      <div>\n        <h1>SeniorAssist</h1>\n        <p>Surveillance & Soins</p>\n      </div>\n    </div>\n  </div>\n\n  <div style=\"padding:10px 0;flex:1;overflow-y:auto;\">\n    <div class=\"nav-lbl\">Général</div>\n    <div class=\"nav-item active\" data-key=\"dashboard\" onclick=\"go('dashboard')\">\n      <span class=\"ico\">🏠</span><span>Tableau de bord</span>\n    </div>\n    <div class=\"nav-lbl\" style=\"margin-top:6px;\">Patients</div>\n    <div id=\"sidebar-patients-nav\">\n      <div class=\"nav-item\" onclick=\"go('dashboard')\">\n        <span class=\"ico\">⏳</span><span style=\"font-size:12px;color:rgba(255,255,255,.4)\">Chargement…</span>\n      </div>\n    </div>\n    <div class=\"nav-lbl\" style=\"margin-top:6px;\">Analyses</div>\n    <div class=\"nav-item\" data-key=\"reports\" onclick=\"go('reports')\">\n      <span class=\"ico\">📋</span><span>Rapports de nuit</span>\n    </div>\n  </div>\n  <div class=\"sidebar-footer\" id=\"sidebar-ts\">—</div>\n</aside>\n\n<!-- ══ MAIN ══ -->\n<main class=\"main\">\n\n  <!-- DASHBOARD -->\n  <div class=\"page active\" id=\"pg-dashboard\">\n    <div class=\"ph\">\n      <h2>Tableau de bord</h2>\n      <p id=\"dash-subtitle\">Chargement des données…</p>\n    </div>\n    <div class=\"stat-row\">\n      <div class=\"stat-card\"><div class=\"sl\">Patients suivis</div><div class=\"sv\" id=\"st-patients\">—</div><div class=\"ss\" id=\"st-patients-s\">—</div></div>\n      <div class=\"stat-card\"><div class=\"sl\">Événements aujourd'hui</div><div class=\"sv\" id=\"st-events\">—</div><div class=\"ss\" id=\"st-events-s\">toutes caméras</div></div>\n      <div class=\"stat-card\"><div class=\"sl\">Alertes actives</div><div class=\"sv\" id=\"st-alerts\" style=\"color:var(--orange)\">—</div><div class=\"ss\" id=\"st-alerts-s\">—</div></div>\n      <div class=\"stat-card\"><div class=\"sl\">Dernière détection</div><div class=\"sv\" style=\"font-size:18px;margin-top:8px;\" id=\"st-lastev\">—</div><div class=\"ss\" id=\"st-lastev-s\">—</div></div>\n    </div>\n    <div class=\"alert-banner\" id=\"alert-banner\">⚠️ <span id=\"alert-text\"></span></div>\n    <div class=\"ct\" style=\"margin-bottom:14px;\">Patients <span class=\"bc\" id=\"patients-count\">…</span></div>\n    <div id=\"pg-dashboard-content\"><div class=\"loader\"><div class=\"spinner\"></div><span>Récupération des données Frigate…</span></div></div>\n  </div>\n\n  <!-- PATIENT DETAIL -->\n  <div class=\"page\" id=\"pg-patient\">\n    <div class=\"dtop\">\n      <button class=\"back-btn\" onclick=\"go('dashboard')\">← Retour</button>\n      <div class=\"dh\">\n        <h2 id=\"pt-name\">—</h2>\n        <p id=\"pt-addr\">—</p>\n      </div>\n      <div id=\"pt-status\"></div>\n    </div>\n    <div class=\"dl\">\n      <div>\n        <div class=\"card cb\" style=\"margin-bottom:16px;\">\n          <div class=\"ct\">📷 Caméras associées</div>\n          <div class=\"cam-pills\" id=\"pt-cameras\">—</div>\n        </div>\n        <div class=\"card cb\">\n          <div class=\"ct\">📌 Événements du jour <span class=\"bc\" id=\"pt-ev-count\">0</span></div>\n          <div class=\"evlist\" id=\"pt-events\"><div class=\"loader\"><div class=\"spinner\"></div><span>Chargement…</span></div></div>\n        </div>\n      </div>\n      <div>\n        <div class=\"card cb\" style=\"margin-bottom:16px;\">\n          <div class=\"ct\">📸 Dernier snapshot</div>\n          <img id=\"pt-snap-img\" alt=\"Dernier snapshot\">\n          <div class=\"snap-ph\" id=\"pt-snap-ph\"><span>📷</span><p>Aperçu non disponible</p></div>\n          <div class=\"snap-cap\" id=\"pt-snap-cap\">—</div>\n        </div>\n        <div class=\"card cb\">\n          <div class=\"ct\">🌙 Rapport de nuit</div>\n          <div class=\"rpt-date\" id=\"pt-rpt-date\">—</div>\n          <pre class=\"rpt-body\" id=\"pt-rpt-text\">Chargement du rapport…</pre>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- REPORTS -->\n  <div class=\"page\" id=\"pg-reports\">\n    <div class=\"ph\">\n      <h2>Rapports de nuit</h2>\n      <p>Historique des rapports générés par Ollama — cliquez pour lire</p>\n    </div>\n    <div class=\"frow\">\n      <select class=\"fsel\" id=\"f-patient\" onchange=\"filterReports()\">\n        <option value=\"\">Tous les patients</option>\n      </select>\n      <input class=\"fdate\" type=\"date\" id=\"f-date\" onchange=\"filterReports()\">\n      <button class=\"btn btn-ghost\" onclick=\"clearFilters()\">✕ Réinitialiser</button>\n    </div>\n    <div class=\"card\" id=\"reports-card\">\n      <div id=\"reports-list\"><div class=\"loader\"><div class=\"spinner\"></div><span>Chargement…</span></div></div>\n    </div>\n  </div>\n\n</main>\n\n<script>\n/* ══════════════════════════════════════════════════════════\n   CONFIG\n══════════════════════════════════════════════════════════ */\nconst origin = window.location.origin;\nconst WH     = origin + '/webhook';                           // n8n webhooks\nconst FRIGATE = origin.replace(/:\\d+/, ':5000');              // Frigate on :5000\n\nconst API = {\n  patients: () => `${WH}/seniorassist-patients`,\n  events:   (pid, after, before) =>\n    `${WH}/seniorassist-events?patientId=${pid}&after=${after}&before=${before}`,\n  reports:  (date) => `${WH}/seniorassist-reports${date ? '?date=' + date : ''}`,\n  snapshot: (id)  => `${FRIGATE}/api/events/${id}/snapshot.jpg`,\n  thumb:    (id)  => `${FRIGATE}/api/events/${id}/thumbnail.jpg`,\n};\n\n/* ══════════════════════════════════════════════════════════\n   STATE\n══════════════════════════════════════════════════════════ */\nlet STATE = {\n  patients: [],\n  reports:  [],\n  currentPatientId: null,\n  loaded: false\n};\n\n/* ══════════════════════════════════════════════════════════\n   UTILITIES\n══════════════════════════════════════════════════════════ */\nfunction todayRange() {\n  const now   = Math.floor(Date.now() / 1000);\n  const start = Math.floor(new Date().setHours(0,0,0,0) / 1000);\n  return { after: start, before: now };\n}\n\nfunction nowStr() {\n  return new Date().toLocaleDateString('fr-FR', {\n    weekday:'long', day:'numeric', month:'long', year:'numeric'\n  });\n}\n\nfunction timeStr(ts) {\n  const d = new Date(ts * 1000);\n  return d.getHours().toString().padStart(2,'0') + ':' + d.getMinutes().toString().padStart(2,'0');\n}\n\nasync function apiFetch(url) {\n  const r = await fetch(url);\n  if (!r.ok) throw new Error(`HTTP ${r.status}`);\n  return r.json();\n}\n\n/* ══════════════════════════════════════════════════════════\n   NAVIGATION\n══════════════════════════════════════════════════════════ */\nfunction go(page, patientId) {\n  document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));\n  const key = page === 'patient' ? `patient-${patientId}` : page;\n  const t = document.querySelector(`[data-key=\"${key}\"]`);\n  if (t) t.classList.add('active');\n\n  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));\n\n  if (page === 'dashboard') {\n    document.getElementById('pg-dashboard').classList.add('active');\n  } else if (page === 'patient') {\n    STATE.currentPatientId = patientId;\n    document.getElementById('pg-patient').classList.add('active');\n    loadPatientPage(patientId);\n  } else if (page === 'reports') {\n    document.getElementById('pg-reports').classList.add('active');\n    loadReportsPage();\n  }\n  window.scrollTo(0, 0);\n}\n\n/* ══════════════════════════════════════════════════════════\n   STATUS HELPERS\n══════════════════════════════════════════════════════════ */\nfunction statusClass(s) {\n  return { normal:'sp-normal', alert:'sp-alert', urgent:'sp-urgent', inactive:'sp-inactive' }[s] || 'sp-inactive';\n}\nfunction statusLabel(s) {\n  return { normal:'Normal', alert:'Alerte', urgent:'Urgence', inactive:'Inactif' }[s] || s;\n}\n\n/* ══════════════════════════════════════════════════════════\n   DASHBOARD\n══════════════════════════════════════════════════════════ */\nasync function loadDashboard() {\n  document.getElementById('dash-subtitle').textContent = nowStr() + ' · Chargement…';\n  try {\n    const data = await apiFetch(API.patients());\n    STATE.patients = data.patients || [];\n    renderDashboard();\n  } catch(e) {\n    document.getElementById('pg-dashboard-content').innerHTML =\n      `<div class=\"err-msg\">❌ Impossible de joindre l'API patients : ${e.message}</div>`;\n  }\n}\n\nfunction renderDashboard() {\n  const patients = STATE.patients;\n  const now = new Date();\n  document.getElementById('dash-subtitle').textContent = nowStr() + ' · ' +\n    now.toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'});\n\n  // Stats\n  const totalEvents = patients.reduce((s, p) => s + (p.eventsToday || 0), 0);\n  const alerts = patients.filter(p => p.status === 'alert' || p.status === 'urgent');\n  document.getElementById('st-patients').textContent  = patients.length;\n  document.getElementById('st-patients-s').textContent = patients.filter(p=>p.cameras&&p.cameras.length>0).length + ' avec caméra(s)';\n  document.getElementById('st-events').textContent    = totalEvents;\n  document.getElementById('st-alerts').textContent    = alerts.length;\n  document.getElementById('st-alerts-s').textContent  = alerts.length > 0 ? alerts.map(p=>p.name).join(', ') : 'Aucune alerte';\n  document.getElementById('patients-count').textContent = patients.length;\n\n  // Last event\n  let lastAct = '—';\n  let lastActSub = '';\n  const withEvent = patients.filter(p => p.lastEventId);\n  if (withEvent.length > 0) {\n    const p = withEvent[0];\n    lastAct    = p.lastActivity.split(' à ')[1] || p.lastActivity;\n    lastActSub = p.name;\n  }\n  document.getElementById('st-lastev').textContent  = lastAct;\n  document.getElementById('st-lastev-s').textContent = lastActSub;\n\n  // Alert banner\n  if (alerts.length > 0) {\n    document.getElementById('alert-banner').style.display = 'flex';\n    document.getElementById('alert-text').innerHTML =\n      `<strong>Alerte :</strong> ${alerts.map(p => p.name + ' — activité anormale détectée').join(' · ')}`;\n  }\n\n  // Sidebar patient nav\n  const nav = document.getElementById('sidebar-patients-nav');\n  nav.innerHTML = patients.map(p => `\n    <div class=\"nav-item\" data-key=\"patient-${p.id}\" onclick=\"go('patient',${p.id})\">\n      <span class=\"ico\">${p.icon}</span><span>${p.name}</span>\n    </div>`).join('');\n\n  // Patient grid\n  document.getElementById('pg-dashboard-content').innerHTML = `\n    <div class=\"pgrid\">\n      ${patients.map(p => `\n        <div class=\"pc\" onclick=\"go('patient',${p.id})\">\n          <div class=\"pc-top\">\n            <div class=\"avatar ${p.avatarCls}\">${p.initials}</div>\n            <div class=\"pc-info\">\n              <h3>${p.name}</h3>\n              <p>📍 ${p.address}</p>\n            </div>\n            <span class=\"sp ${statusClass(p.status)}\">${statusLabel(p.status)}</span>\n          </div>\n          <div class=\"cam-pills\">\n            ${p.cameras && p.cameras.length > 0\n              ? p.cameras.map(c=>`<span class=\"cam-pill\">📷 ${c}</span>`).join('')\n              : '<span class=\"cam-pill\" style=\"color:#94A3B8\">Aucune caméra configurée</span>'}\n          </div>\n          <div class=\"pc-foot\">\n            <div>\n              <div class=\"la-lbl\">Dernière activité</div>\n              <div class=\"la-val\">${p.lastActivity}</div>\n            </div>\n            <button class=\"btn btn-primary\" onclick=\"event.stopPropagation();go('patient',${p.id})\">\n              Dossier →\n            </button>\n          </div>\n        </div>`).join('')}\n    </div>`;\n\n  STATE.loaded = true;\n  document.getElementById('sidebar-ts').textContent =\n    'Màj ' + new Date().toLocaleTimeString('fr-FR', {hour:'2-digit',minute:'2-digit'});\n}\n\n/* ══════════════════════════════════════════════════════════\n   PATIENT PAGE\n══════════════════════════════════════════════════════════ */\nasync function loadPatientPage(pid) {\n  const patient = STATE.patients.find(p => p.id === pid);\n  if (!patient) { await loadDashboard(); }\n  const p = STATE.patients.find(p => p.id === pid) || {\n    name:'Chargement…', address:'', cameras:[], status:'normal', lastEventId:null\n  };\n\n  // Header\n  document.getElementById('pt-name').textContent  = p.name;\n  document.getElementById('pt-addr').textContent  = p.address ? '📍 ' + p.address : '';\n  document.getElementById('pt-status').innerHTML  =\n    `<span class=\"sp ${statusClass(p.status)}\">${statusLabel(p.status)}</span>`;\n  document.getElementById('pt-cameras').innerHTML = p.cameras && p.cameras.length > 0\n    ? p.cameras.map(c=>`<span class=\"cam-pill\">📷 ${c}</span>`).join('')\n    : '<span style=\"font-size:12px;color:var(--muted)\">Aucune caméra configurée</span>';\n\n  // Snapshot\n  const snapImg = document.getElementById('pt-snap-img');\n  const snapPh  = document.getElementById('pt-snap-ph');\n  const snapCap = document.getElementById('pt-snap-cap');\n  if (p.lastEventId) {\n    snapImg.src = API.snapshot(p.lastEventId);\n    snapImg.style.display = 'block';\n    snapPh.style.display  = 'none';\n    snapCap.textContent   = 'Dernière détection : ' + p.lastActivity;\n    snapImg.onerror = () => { snapImg.style.display='none'; snapPh.style.display='flex'; };\n  } else {\n    snapImg.style.display = 'none';\n    snapPh.style.display  = 'flex';\n    snapCap.textContent   = 'Aucune détection récente';\n  }\n\n  // Events (async)\n  document.getElementById('pt-events').innerHTML =\n    '<div class=\"loader\"><div class=\"spinner\"></div><span>Récupération des événements Frigate…</span></div>';\n  document.getElementById('pt-ev-count').textContent = '…';\n\n  const { after, before } = todayRange();\n  try {\n    const data = await apiFetch(API.events(pid, after, before));\n    renderEvents(data.events || []);\n  } catch(e) {\n    document.getElementById('pt-events').innerHTML =\n      `<div class=\"err-msg\">❌ Erreur Frigate : ${e.message}</div>`;\n  }\n\n  // Report (async)\n  document.getElementById('pt-rpt-date').textContent = 'Chargement…';\n  document.getElementById('pt-rpt-text').textContent = '';\n  try {\n    const today = new Date().toISOString().split('T')[0];\n    const data  = await apiFetch(API.reports(today));\n    const reports = data.reports || [];\n    if (reports.length > 0) {\n      const rpt = reports[0];\n      document.getElementById('pt-rpt-date').textContent = '📅 ' + rpt.dateLabel +\n        (rpt.generatedAt ? ' · Généré à ' + new Date(rpt.generatedAt).toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'}) : '');\n      document.getElementById('pt-rpt-text').textContent = rpt.report;\n    } else {\n      document.getElementById('pt-rpt-date').textContent = '📅 ' + new Date().toLocaleDateString('fr-FR');\n      document.getElementById('pt-rpt-text').textContent =\n        'Aucun rapport disponible pour cette nuit.\\nLe rapport sera généré automatiquement à 07h00 par le workflow \"Rapport de nuit — Frigate + Ollama\".';\n    }\n  } catch(e) {\n    document.getElementById('pt-rpt-text').textContent = '⚠️ Impossible de charger le rapport : ' + e.message;\n  }\n}\n\nfunction renderEvents(events) {\n  document.getElementById('pt-ev-count').textContent = events.length;\n  if (!events.length) {\n    document.getElementById('pt-events').innerHTML =\n      '<div class=\"ev-empty\">Aucun événement détecté aujourd\\'hui pour ce patient.</div>';\n    return;\n  }\n  document.getElementById('pt-events').innerHTML = events.map(e => {\n    const thumbUrl = e.hasSnapshot ? API.thumb(e.id) : null;\n    const thumbHtml = thumbUrl\n      ? `<img class=\"ev-thumb\" src=\"${thumbUrl}\" alt=\"snapshot\"\n             onerror=\"this.style.display='none';this.nextElementSibling.style.display='flex'\"\n          ><div class=\"ev-thumb-ph\" style=\"display:none\">📷</div>`\n      : `<div class=\"ev-thumb-ph\">📷</div>`;\n    return `\n      <div class=\"ev\">\n        <div class=\"ev-time\">${e.time}</div>\n        ${thumbHtml}\n        <div class=\"ev-info\">\n          <div class=\"ev-lbl\">${e.label}</div>\n          <div class=\"ev-cam\">${e.camera}</div>\n        </div>\n        <span class=\"ev-score\">${e.score}%</span>\n      </div>`;\n  }).join('');\n}\n\n/* ══════════════════════════════════════════════════════════\n   REPORTS PAGE\n══════════════════════════════════════════════════════════ */\nasync function loadReportsPage() {\n  // Populate patient filter\n  const fsel = document.getElementById('f-patient');\n  if (STATE.patients.length > 0 && fsel.options.length === 1) {\n    STATE.patients.forEach(p => {\n      const o = document.createElement('option');\n      o.value = p.id; o.textContent = p.icon + ' ' + p.name;\n      fsel.appendChild(o);\n    });\n  }\n  // Default date = today\n  if (!document.getElementById('f-date').value) {\n    document.getElementById('f-date').value = new Date().toISOString().split('T')[0];\n  }\n\n  document.getElementById('reports-list').innerHTML =\n    '<div class=\"loader\"><div class=\"spinner\"></div><span>Chargement des rapports…</span></div>';\n  try {\n    const date = document.getElementById('f-date').value;\n    const data  = await apiFetch(API.reports(date || null));\n    STATE.reports = data.reports || [];\n    renderReports(STATE.reports);\n  } catch(e) {\n    document.getElementById('reports-list').innerHTML =\n      `<div class=\"err-msg\">❌ Erreur : ${e.message}</div>`;\n  }\n}\n\nfunction renderReports(list) {\n  if (!list.length) {\n    document.getElementById('reports-list').innerHTML =\n      '<div style=\"padding:36px;text-align:center;color:var(--muted)\">Aucun rapport pour ces critères.<br><small>Les rapports sont générés chaque matin à 07h00.</small></div>';\n    return;\n  }\n  document.getElementById('reports-list').innerHTML = list.map((r, i) => {\n    const lines = (r.report || '').split('\\n');\n    const preview = lines.find(l => l.trim() && !l.startsWith('Rapport')) || 'Rapport disponible';\n    return `\n      <div class=\"ri\" onclick=\"toggleRi(this)\">\n        <div class=\"ri-hd\">\n          <div>\n            <div class=\"ri-patient\">📋 ${r.dateLabel}</div>\n            <div class=\"ri-preview\">${preview.substring(0,80)}…</div>\n          </div>\n          <div style=\"display:flex;align-items:center;gap:10px;flex-shrink:0;\">\n            <span class=\"ri-date\">${r.generatedAt\n              ? '⏱ ' + new Date(r.generatedAt).toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'})\n              : r.dateLabel}</span>\n            <span class=\"ri-chev\">▼</span>\n          </div>\n        </div>\n        <div class=\"ri-body\">\n          <pre class=\"ri-rpt\">${r.report || 'Contenu non disponible.'}</pre>\n        </div>\n      </div>`;\n  }).join('');\n}\n\nfunction toggleRi(el) {\n  const body  = el.querySelector('.ri-body');\n  const chev  = el.querySelector('.ri-chev');\n  body.classList.toggle('open');\n  chev.classList.toggle('open');\n}\n\nasync function filterReports() {\n  const date = document.getElementById('f-date').value;\n  document.getElementById('reports-list').innerHTML =\n    '<div class=\"loader\"><div class=\"spinner\"></div><span>Filtrage…</span></div>';\n  try {\n    const data = await apiFetch(API.reports(date || null));\n    renderReports(data.reports || []);\n  } catch(e) {\n    document.getElementById('reports-list').innerHTML = `<div class=\"err-msg\">❌ ${e.message}</div>`;\n  }\n}\n\nfunction clearFilters() {\n  document.getElementById('f-patient').value = '';\n  document.getElementById('f-date').value = new Date().toISOString().split('T')[0];\n  filterReports();\n}\n\n/* ══════════════════════════════════════════════════════════\n   AUTO-REFRESH — Dashboard toutes les 60 s\n══════════════════════════════════════════════════════════ */\nsetInterval(() => {\n  const dash = document.getElementById('pg-dashboard');\n  if (dash.classList.contains('active')) loadDashboard();\n}, 60000);\n\n/* ══════════════════════════════════════════════════════════\n   INIT\n══════════════════════════════════════════════════════════ */\nloadDashboard();\n</script>\n</body>\n</html>\n",
