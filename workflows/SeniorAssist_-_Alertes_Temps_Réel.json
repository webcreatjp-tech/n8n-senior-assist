    {
      "parameters": {
        "jsCode": "let payload;\ntry {\n  payload = JSON.parse($input.item.json.message);\n} catch(e) { return []; }\n\n// Uniquement les nouvelles alertes\nif (payload.type !== 'new') return [];\n\nconst review = payload.after || {};\nif (review.severity !== 'alert') return [];\n\nconst camera = review.camera || 'inconnue';\nconst zones = review.data?.zones || [];\nconst heure = new Date().toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit', second:'2-digit'});\nconst heure_num = new Date().getHours();\n\n// --- INTRUSION NOCTURNE ---\nif (heure_num >= 23 || heure_num < 6) {\n  return [{ json: {\n    type_alerte: 'INTRUSION NOCTURNE',\n    message_alerte: `Présence détectée sur la caméra \"${camera}\" à ${heure} (zone: ${zones.join(', ')}). Vérification immédiate recommandée.`,\n    niveau_urgence: 'CRITIQUE',\n    heure, camera, score: 0\n  }}];\n}\n\n// --- ALERTE JOURNÉE ---\nreturn [{ json: {\n  type_alerte: 'PRÉSENCE ANORMALE',\n  message_alerte: `Alerte détectée sur la caméra \"${camera}\" à ${heure} dans la zone: ${zones.join(', ')}.`,\n  niveau_urgence: 'ATTENTION',\n  heure, camera, score: 0\n}}];"
      },
