        "subject": "={{ $json.type_alerte }}",
        "message": "=<!DOCTYPE html>\n<html lang=\"fr\">\n<head><meta charset=\"UTF-8\"></head>\n<body style=\"margin:0; padding:0; background:#f0f2f5; font-family:Arial,sans-serif;\">\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f0f2f5; padding:32px 16px;\">\n<tr><td align=\"center\">\n<table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#fff; border-radius:16px; border:1px solid #e0e0e0;\">\n\n  <!-- HEADER -->\n  <tr>\n    <td style=\"background:{{ $json.niveau_urgence === 'CRITIQUE' ? '#A32D2D' : '#BA7517' }}; padding:24px 32px; border-radius:16px 16px 0 0;\">\n      <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n        <tr>\n          <td style=\"color:#fff; font-size:20px; font-weight:700;\">SeniorAssist</td>\n          <td align=\"right\" style=\"color:rgba(255,255,255,0.8); font-size:13px;\">{{ $json.heure }}</td>\n        </tr>\n      </table>\n      <p style=\"color:rgba(255,255,255,0.9); font-size:14px; margin:6px 0 0;\">Alerte automatique · Caméra {{ $json.camera }}</p>\n    </td>\n  </tr>\n\n  <!-- BADGE ALERTE -->\n  <tr>\n    <td style=\"padding:24px 32px 0;\">\n      <table cellpadding=\"0\" cellspacing=\"0\">\n        <tr>\n          <td style=\"background:{{ $json.niveau_urgence === 'CRITIQUE' ? '#FCEBEB' : '#FAEEDA' }}; color:{{ $json.niveau_urgence === 'CRITIQUE' ? '#A32D2D' : '#854F0B' }}; font-size:13px; font-weight:700; padding:8px 16px; border-radius:8px; letter-spacing:0.05em;\">{{ $json.type_alerte }}</td>\n        </tr>\n      </table>\n    </td>\n  </tr>\n\n  <!-- MESSAGE -->\n  <tr>\n    <td style=\"padding:16px 32px 0;\">\n      <p style=\"font-size:16px; line-height:1.7; color:#2C2C2A; margin:0;\">{{ $json.message_alerte }}</p>\n    </td>\n  </tr>\n\n  <!-- STATS -->\n  <tr>\n    <td style=\"padding:20px 32px 0;\">\n      <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n        <tr>\n          <td width=\"50%\" style=\"padding-right:6px;\">\n            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f6f6f6; border-radius:10px; border:1px solid #e8e8e8;\">\n              <tr><td style=\"padding:12px; text-align:center;\">\n                <div style=\"font-size:20px; font-weight:700; color:#444;\">{{ $json.score }}%</div>\n                <div style=\"font-size:11px; color:#999; margin-top:4px; text-transform:uppercase; letter-spacing:0.05em;\">Score détection</div>\n              </td></tr>\n            </table>\n          </td>\n          <td width=\"50%\" style=\"padding-left:6px;\">\n            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f6f6f6; border-radius:10px; border:1px solid #e8e8e8;\">\n              <tr><td style=\"padding:12px; text-align:center;\">\n                <div style=\"font-size:20px; font-weight:700; color:#444;\">{{ $json.camera }}</div>\n                <div style=\"font-size:11px; color:#999; margin-top:4px; text-transform:uppercase; letter-spacing:0.05em;\">Caméra</div>\n              </td></tr>\n            </table>\n          </td>\n        </tr>\n      </table>\n    </td>\n  </tr>\n\n  <!-- ACTION -->\n  <tr>\n    <td style=\"padding:20px 32px 28px;\">\n      <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:{{ $json.niveau_urgence === 'CRITIQUE' ? '#FCEBEB' : '#FAEEDA' }}; border-radius:10px; border:1px solid {{ $json.niveau_urgence === 'CRITIQUE' ? '#F09595' : '#FAC775' }};\">\n        <tr><td style=\"padding:14px 16px;\">\n          <p style=\"font-size:13px; font-weight:700; color:{{ $json.niveau_urgence === 'CRITIQUE' ? '#A32D2D' : '#854F0B' }}; margin:0 0 4px; text-transform:uppercase; letter-spacing:0.05em;\">Action requise</p>\n          <p style=\"font-size:14px; color:#2C2C2A; margin:0; line-height:1.6;\">{{ $json.niveau_urgence === 'CRITIQUE' ? 'Intervenir immédiatement auprès du résident. Contacter les secours si nécessaire.' : 'Vérifier l\\'état du résident dans les plus brefs délais.' }}</p>\n        </td></tr>\n      </table>\n    </td>\n  </tr>\n\n  <!-- PHOTO CAMÉRA -->\n  <tr>\n    <td style=\"padding:0 32px 20px;\">\n      <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#F5F5F5; border-radius:10px; border:1px solid #E0E0E0;\">\n        <tr><td style=\"padding:14px 16px;\">\n          <p style=\"font-size:13px; font-weight:700; color:#555; margin:0 0 4px; text-transform:uppercase; letter-spacing:0.05em;\">📷 Snapshot caméra {{ $json.camera }}</p>\n          <p style=\"font-size:13px; color:#888; margin:0; line-height:1.5;\">{{ $json.has_photo ? 'Photo ci-jointe — état de la caméra au moment de l\\'alerte.' : 'Aucune photo disponible (caméra hors ligne).' }}</p>\n        </td></tr>\n      </table>\n    </td>\n  </tr>\n\n  <!-- FOOTER -->\n  <tr>\n    <td style=\"padding:16px 32px 20px; background:#fafafa; border-top:1px solid #f0f0f0; border-radius:0 0 16px 16px;\">\n      <p style=\"font-size:12px; color:#aaa; margin:0;\">Alerte générée automatiquement par SeniorAssist.</p>\n      <p style=\"font-size:12px; color:#ccc; margin:6px 0 0;\">Propulsé par <span style=\"color:#1D9E75;\">WEB-CREAT</span> · Automatisation IA pour les professionnels</p>\n    </td>\n  </tr>\n\n</table>\n</td></tr>\n</table>\n</body>\n</html>",
