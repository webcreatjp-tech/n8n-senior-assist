    {
      "parameters": {
        "jsCode": "\nconst items = $input.all().map(i => i.json).filter(e => e.id && e.end_time);\nif (!items.length) return [];\n\nreturn items.map(evt => {\n  const dt = new Date(evt.start_time * 1000);\n  const date = dt.toLocaleDateString('fr-FR');\n  const heure = dt.toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit', second:'2-digit'});\n  const score = evt.data?.top_score ? Math.round(evt.data.top_score * 100) : null;\n  const duree = evt.end_time ? Math.round(evt.end_time - evt.start_time) : null;\n  const severite = evt.data?.max_severity || 'detection';\n  return { json: {\n    Date: date,\n    Heure: heure,\n    'Caméra': evt.camera || 'inconnue',\n    'Score%': score ? score + '%' : '--',\n    'Durée(s)': duree || '--',\n    Sévérité: severite,\n    ID_Frigate: evt.id\n  }};\n});\n"
      },
